# Bright Data — get your API token at https://brightdata.com/cp/setting/users
# Sign up with promo code: hackersquad100 ($100 credit, valid 2 months)
BRIGHTDATA_API_TOKEN=

# Web Unlocker zone name from https://brightdata.com/cp/zones
# Leave blank to auto-detect the first active unblocker zone on your account.
# The script falls back to direct HTTP if Bright Data is unavailable.
BRIGHTDATA_WEB_UNLOCKER_ZONE=

# Set to false to disable auto-creating a Web Unlocker zone when none exists
BRIGHTDATA_AUTO_CREATE_ZONE=true
BRIGHTDATA_BROWSER_ZONE=mcp_browser
BRIGHTDATA_PRO_MODE=true

# Commentary LLM — OpenRouter free model is default; OpenAI is fallback
# Get a key at https://openrouter.ai/keys
COMMENTARY_LLM=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional paid / project OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Optional commentator (ElevenLabs required for natural voice; LLM keys optional)
ENABLE_COMMENTARY=false
ELEVENLABS_API_KEY=
# Adam — clear announcer-style public voice. Swap for any voice from your account.
ELEVENLABS_VOICE_ID=xFPwxsyzPJFEaL61n2ms
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.28
ELEVENLABS_SIMILARITY=0.85
ELEVENLABS_STYLE=0.55

# Trailing callout when health gap exceeds this fraction of max HP
COMMENTARY_TRAIL_GAP=0.25

API_PORT=8787

# Data sources Bright Data will scrape for Pro League stats
BATTLEBOTS_PRO_LEAGUE_URL=https://battlebots.com/proleague/
BATTLEBOTS_WIKI_URL=https://battlebots.fandom.com/wiki/BattleBots_Pro_League
