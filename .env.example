# Bright Data — get your API token at https://brightdata.com/cp/setting/users
# Sign up with promo code: hackersquad100 ($100 credit, valid 2 months)
BRIGHTDATA_API_TOKEN=

# Optional zone overrides (defaults work for MCP / Web Unlocker)
BRIGHTDATA_WEB_UNLOCKER_ZONE=mcp_unlocker
BRIGHTDATA_BROWSER_ZONE=mcp_browser
BRIGHTDATA_PRO_MODE=true

# Optional: LLM for commentary scripts
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional commentator (requires both keys + ENABLE_COMMENTARY=true)
ENABLE_COMMENTARY=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Trailing callout when health gap exceeds this fraction of max HP
COMMENTARY_TRAIL_GAP=0.25

API_PORT=8787

# Data sources Bright Data will scrape for Pro League stats
BATTLEBOTS_PRO_LEAGUE_URL=https://battlebots.com/proleague/
BATTLEBOTS_WIKI_URL=https://battlebots.fandom.com/wiki/BattleBots_Pro_League
